1 ICON "../Hhub.App/Assets/Hhub.ico"

#ifndef HHUB_FILE_VERSION
#define HHUB_FILE_VERSION 0,0,0,0
#endif

#ifndef HHUB_PRODUCT_VERSION
#define HHUB_PRODUCT_VERSION 0.0.0
#endif

#define HHUB_STRINGIFY(value) #value
#define HHUB_VERSION_TEXT(value) HHUB_STRINGIFY(value)

1 VERSIONINFO
FILEVERSION HHUB_FILE_VERSION
PRODUCTVERSION HHUB_FILE_VERSION
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HHub\0"
            VALUE "FileVersion", HHUB_VERSION_TEXT(HHUB_PRODUCT_VERSION)
            VALUE "ProductVersion", HHUB_VERSION_TEXT(HHUB_PRODUCT_VERSION)
            VALUE "ProductName", "HHub\0"
            VALUE "OriginalFilename", "Hhub.Tray.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
