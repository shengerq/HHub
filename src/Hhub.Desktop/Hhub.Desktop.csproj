<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../Hhub.App/Assets/Hhub.ico</ApplicationIcon>
    <Product>HHub</Product>
    <Version>0.7.0</Version>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Description>HHub</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/Release-0.7.0.txt" LogicalName="HHub.ReleaseNotes.txt" />
    <ProjectReference Include="../Hhub.Core/Hhub.Core.csproj" />
    <ProjectReference Include="../Hhub.PluginUi/Hhub.PluginUi.csproj" />
    <ProjectReference Include="../Hhub.UnifiedHost/Hhub.UnifiedHost.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <Content Include="../Hhub.App/Assets/Hhub.png" Link="Assets/Hhub.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Hhub.App/Assets/Hhub.ico" Link="Assets/Hhub.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
